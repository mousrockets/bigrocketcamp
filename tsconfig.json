{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/web/*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The web app's API client is typed from the Worker's routes (`AppType`): checking them needs the Worker's
  // bindings, declared in runtime.d.ts and env.d.ts. Only types cross over: no Worker code reaches the bundle.
  "include": [
    "scripts",
    "src/lib",
    "src/web",
    "src/vite-env.d.ts",
    "src/worker/runtime.d.ts",
    "src/worker/env.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/lib/**/*.test.ts", "src/web/sw"]
}

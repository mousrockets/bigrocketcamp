{
  "name": "bigrocketcamp",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "biome check . && tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/worker/tsconfig.json && vitest run",
    "fmt": "biome check --write .",
    "types": "wrangler types src/worker/runtime.d.ts",
    "deploy": "wrangler d1 migrations apply bigrocketcamp --remote --config wrangler.jsonc && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply bigrocketcamp --local --config wrangler.jsonc",
    "db:seed": "wrangler d1 execute bigrocketcamp --local --config wrangler.jsonc --file scripts/seed-dev.sql",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --host 127.0.0.1 --port 10077"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@libsql/client": "0.18.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@hono/zod-validator": "0.9.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "input-otp": "1.5.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "11.0.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}

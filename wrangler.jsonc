{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bigrocketcamp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The worker answers /api/*; every other path is the web app, served as static files.
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true },
  // Instance settings (MAIL_FROM…) live in the dashboard: a deploy must not erase them.
  "keep_vars": true,
  // The instance lives on its own domain: no workers.dev address, no preview URLs to configure twice.
  "workers_dev": false,
  "preview_urls": false,
  // Every hour: closes the months that ended (idempotent, cheap). See src/worker/index.ts.
  "triggers": { "crons": ["5 * * * *"] },
  // The id and creation time of the running version: /api/health shows when it was deployed.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bigrocketcamp",
      // Not a secret: the ID only names the database inside the owner's Cloudflare account.
      "database_id": "422b85f6-379f-48ee-bc41-d832ff3727dc",
      "migrations_dir": "migrations"
    }
  ]
}

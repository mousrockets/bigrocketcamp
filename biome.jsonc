{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // runtime.d.ts is generated by `npm run types`.
  "files": { "includes": ["**", "!src/worker/runtime.d.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } },
  // Biome only parses the style sheets: their formatting and rules stay the shadcn ones.
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      // The shadcn components stay close to upstream, so that a later `shadcn add --diff` remains readable.
      "includes": ["src/web/components/ui/**"],
      "formatter": { "enabled": false },
      "linter": { "enabled": false }
    }
  ]
}
